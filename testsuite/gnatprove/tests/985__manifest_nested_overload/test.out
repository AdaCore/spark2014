===== nested path must extend parent =====
--- manifest pkg.toml ---
version = 1

[[rule]]
path = "Pkg.Set"
kind = "procedure"
profile = "(_ : Integer)"
steps = 111
provers = ["cvc5"]

  [[rule.rule]]
  path = "Pkg.Other.Helper"
  kind = "procedure"
  steps = 333
  provers = ["cvc5"]
--- output ---
Try "gnatprove --help" for more information.
error: invalid proof manifest nested_path_must_extend_parent/pkg.toml:11:10: nested path "Pkg.Other.Helper" must extend the enclosing path "Pkg.Set"
===== nested rule array must not be empty =====
--- manifest pkg.toml ---
version = 1

[[rule]]
path = "Pkg.Set"
kind = "procedure"
profile = "(_ : Boolean)"
rule = []
--- output ---
Try "gnatprove --help" for more information.
error: invalid proof manifest nested_rule_array_must_not_be_empty/pkg.toml:7:8: field "rule" must not be empty
