with "sparklib";

project higher_order_fold is

   package Builder is
      for Global_Configuration_Pragmas use "test.adc";
   end Builder;

   package Compiler is
      for Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--report=all", "-u", "array_max.ads");
   end Prove;

end higher_order_fold;
