with "sparklib";

project Buffers is

   package Builder is
      for Global_Configuration_Pragmas use "test.adc";
   end Builder;

   package Compiler is
      for Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--report=all", "-u", "buffers.adb");
   end Prove;

end Buffers;
