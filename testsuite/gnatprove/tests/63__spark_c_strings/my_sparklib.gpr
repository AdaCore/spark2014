with "sparklib_common";

project My_SPARKlib extends "sparklib_internal" is

   for Object_Dir use "sparklib_obj";
   for Source_Dirs use SPARKlib_Internal'Source_Dirs;
   --  The file providing the root SPARK unit varies with the body
   --  mode, so it is named through SPARKlib_common rather than
   --  spelled out here.
   for Source_Files use SPARKlib_common.Mode_Source_Files & ("spark-c.ads", "spark-c-strings.ads", "spark-c-strings.adb", "spark-c-constant_strings.ads", "spark-c-constant_strings.adb");
end My_SPARKlib;
