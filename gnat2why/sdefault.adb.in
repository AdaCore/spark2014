--  This is the SPARK 2014 target dependent version of package body Sdefault.

--  This package body provides the SPARK implementation of the routines
--  that locate the Ada library source and object directories.

--  In the case of SPARK, we care both about the location of the adainclude
--  and adalib directories, so generate them from Makefile.generic, using the
--  native compiler.

with Osint;        use Osint;
with SPARK_Target;

package body Sdefault is
   pragma Style_Checks (Off);

   ----------------
   -- Local Data --
   ----------------

   Prefix         : constant String := "@PREFIX@";
   Default_Target : constant String := "@TARGET@";
   --  Target name used when gnatprove did not provide one, e.g. when gnat2why
   --  is run by hand. It is deliberately not substituted at build time, so
   --  that it cannot be mistaken for the name of a real target.

   ------------------------------
   -- Include_Dir_Default_Name --
   ------------------------------

   function Include_Dir_Default_Name return String_Ptr is
   begin
      return Relocate_Path (Prefix, "@ADAINCLUDE@");
   end Include_Dir_Default_Name;

   -----------------------------
   -- Object_Dir_Default_Name --
   -----------------------------

   function Object_Dir_Default_Name return String_Ptr is
   begin
      return Relocate_Path (Prefix, "@ADALIB@");
   end Object_Dir_Default_Name;

   -----------------------
   -- Search_Dir_Prefix --
   -----------------------

   function Search_Dir_Prefix return String_Ptr is
   begin
      return Relocate_Path (Prefix, "@GNAT1DIR@");
   end Search_Dir_Prefix;

   -----------------
   -- Target_Name --
   -----------------

   function Target_Name return String_Ptr is
   begin
      --  The target name is the one of the toolchain that would compile the
      --  analyzed code, as computed by gnatprove and passed to gnat2why in
      --  the extra options. This is what makes attribute Target_Name have the
      --  same value in analysis as in compilation.

      if SPARK_Target.Target_Name /= null then
         return SPARK_Target.Target_Name;
      else
         return new String'(Default_Target);
      end if;
   end Target_Name;

end Sdefault;
