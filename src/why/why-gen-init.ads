with Gnat2Why.Util;        use Gnat2Why.Util;
with SPARK_Atree;          use SPARK_Atree;
with SPARK_Atree.Entities; use SPARK_Atree.Entities;
with SPARK_Util.Types;     use SPARK_Util.Types;
with Types;                use Types;
with Why.Atree.Accessors;  use Why.Atree.Accessors;
with Why.Atree.Modules;    use Why.Atree.Modules;
with Why.Conversions;      use Why.Conversions;
with Why.Ids;              use Why.Ids;
with Why.Sinfo;            use Why.Sinfo;

package Why.Gen.Init is
   --  This package encapsulates the encoding of initialization by proof.
   --
   --  Scalar wrappers contain a value and an __attr__init flag. Simple
   --  private types use the same layout with an abstract value. Composite
   --  wrappers retain the ordinary representation's structure but use
   --  wrappers for components which can have relaxed initialization. Bounds
   --  and discriminants remain unwrapped. Records with mutable discriminants
   --  and access-to-object types have an additional top-level flag, for the
   --  discriminants or pointer state respectively. Hidden private parts of
   --  records have their own initialization flag.
   --
   --  Has_Init_Wrapper identifies Ada types which can occur in expressions
   --  with relaxed initialization. EW_Abstract and EW_Split select their
   --  wrapper representation with Relaxed_Init => True. Is_Init_Wrapper_Type
   --  tests this representation flag in W_Type_Id. Expr_Has_Relaxed_Init and
   --  Obj_Has_Relaxed_Init determine which representation a use requires.
   --
   --  Wrapper declarations are in the Init_Wrapper module. Array wrappers
   --  share map theories for wrapped elements and use separate conversion
   --  modules, as other arrays with different component types do. Scalar and
   --  record wrappers declare of_wrapper and to_wrapper in their module;
   --  pointer conversions belong to their representative modules.
   --  Generated conversion functions do not check initialization. Callers
   --  generating reads use Insert_Checked_Conversion or
   --  Insert_Initialization_Check.
   --
   --  Wrappers for accesses to incomplete types have separate representative
   --  completions, generated by Why.Gen.Pointers when the full view is
   --  translated. Composite is_initialized predicates are defined in the
   --  type's main completion module by Gnat2Why.Types. If needed by an
   --  incomplete access representation, they are predeclared and later
   --  completed by a defining axiom.

   procedure Declare_Simple_Wrapper_Type
     (Th           : Theory_UC;
      W_Nam        : W_Name_Id;
      Init_Val     : W_Identifier_Id;
      Attr_Init    : W_Identifier_Id;
      Of_Wrapper   : W_Identifier_Id;
      To_Wrapper   : W_Identifier_Id;
      Dummy        : W_Identifier_Id;
      Default_Init : Boolean);
   --  Declare a wrapper type named W_Nam with value field Init_Val and
   --  initialization flag Attr_Init. Generate conversion functions named
   --  Of_Wrapper and To_Wrapper, and a dummy value named Dummy. The dummy's
   --  flag is Default_Init; its value field is unconstrained.

   procedure Declare_Init_Wrapper (Th : Theory_UC; E : Entity_Id)
   with Pre => Is_Type (E);
   --  Add declarations for a wrapper type for E in Th

   function Is_Init_Wrapper_Type (Typ : W_Type_Id) return Boolean;
   --  Return the Relaxed_Init flag of Typ

   function EW_Init_Wrapper (Ty : W_Type_Id) return W_Type_Id
   with
     Pre =>
       Ty = EW_Bool_Type
       or else
         (Get_Type_Kind (Ty) in EW_Abstract | EW_Split
          and then Has_Init_Wrapper (Get_Ada_Node (+Ty)));
   --  Return the wrapper representation of Ty. EW_Bool_Type uses the
   --  predefined Boolean wrapper; other types retain their Ada node and kind.

   type Exclude_Components_Kind is (For_Eq, Relaxed, None);
   --  Relaxed excludes components whose types have Relaxed_Initialization.
   --  For_Eq checks components read by predefined equality: it does not
   --  follow pointers and excludes relaxed parts passed to user-defined
   --  component equalities. None includes all components.

   function Compute_Is_Initialized
     (E                  : Entity_Id;
      Name               : W_Expr_Id;
      Params             : Transformation_Params;
      Domain             : EW_Domain;
      Exclude_Components : Exclude_Components_Kind;
      No_Predicate_Check : Boolean := False;
      Use_Pred           : Boolean := True) return W_Expr_Id
   with
     Pre =>
       (if Present (E) and then Contains_Access_Subcomponents (E)
        then Exclude_Components /= None);
   --  Return whether Name is initialized, including components selected
   --  by Exclude_Components. Array elements are checked within the bounds;
   --  absent variant fields and null designated values are not checked.
   --  E should be the Ada type of Name unless Name is a standard boolean.
   --
   --  If Exclude_Components is Relaxed, do not include initialization of
   --  subcomponents whose type is annotated with relaxed initialization. A
   --  component can use a wrapper because its enclosing object has relaxed
   --  initialization, even when its own type does not have the aspect.
   --  Converting to the ordinary representation checks these components but
   --  leaves components whose types have the aspect in their wrapper form.
   --
   --  For_Eq still requires a component compared with user-defined equality
   --  to be initialized for conversion to its ordinary representation. Parts
   --  whose types have relaxed initialization are left to that equality's
   --  contract.
   --
   --  For composite wrappers, the result includes applicable subtype
   --  predicates. No_Predicate_Check excludes the predicates of E itself.
   --  Predicates of subcomponents are still considered.
   --
   --  If Use_Pred is True, use the predicate symbol introduced for the type
   --  whenever possible. This requires an abstract composite wrapper,
   --  Exclude_Components = Relaxed, and No_Predicate_Check = False. Itypes
   --  are expanded at each use. Set Use_Pred to False when defining the
   --  predicate itself.
   --
   --  None expands components directly and cannot use the named predicate.
   --  The precondition excludes it for types containing accesses to prevent
   --  unbounded expansion through recursive data structures.

   function New_Init_Attribute_Access
     (E : Entity_Id; Name : W_Term_Id) return W_Term_Id;
   --  Access the initialization flag of an expression of a wrapper type.
   --  Name shall be of the init wrapper type of Boolean or E shall be a type
   --  entity whose wrapper has a top-level flag (scalar type, simple private
   --  type, record type with mutable discriminants, or access-to-object type).

   function Insert_Initialization_Check
     (Ada_Node           : Node_Id;
      E                  : Entity_Id;
      Name               : W_Expr_Id;
      Domain             : EW_Domain;
      Exclude_Components : Exclude_Components_Kind;
      No_Predicate_Check : Boolean := False) return W_Expr_Id;
   --  If Domain = EW_Prog, check initialization as selected by
   --  Exclude_Components and No_Predicate_Check, then return Name. Name is
   --  evaluated once. Other domains return Name without a check. Ordinary
   --  representations can also require a check for nested relaxed parts.

   function Insert_Top_Level_Init_Check
     (Ada_Node : Node_Id;
      E        : Entity_Id;
      Name     : W_Expr_Id;
      Domain   : EW_Domain;
      Do_Check : Boolean := True;
      Details  : String := "") return W_Expr_Id;
   --  If Domain = EW_Prog, insert a check that the mutable discriminants or
   --  pointer address of Name (if any) are initialized.
   --  Details is used to generate the check details (aka reason for check).

end Why.Gen.Init;
